# Production Backend Environment Variables Example
PORT=5000
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/users/google/callback
CLIENT_REDIRECT_URL=http://localhost:3000/login
GEMINI_API_KEY=your_gemini_api_key_here
